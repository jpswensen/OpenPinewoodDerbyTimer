# PWDTimer Environment Configuration
#
# Copy this file and adjust values for your deployment:
#   cp .env.example .env
#
# Docker Compose reads this file automatically.
# For systemd, reference it via EnvironmentFile= directive.
# For start-prod.sh, source it: set -a; source .env; set +a; ./scripts/start-prod.sh

# ── Server ────────────────────────────────────────────────────────────────────
PWD_TIMER_HOST=0.0.0.0
PWD_TIMER_PORT=8000
PWD_TIMER_WORKERS=1
PWD_TIMER_LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — single-file, zero-config):
PWD_TIMER_DB_URL=sqlite+aiosqlite:///data/pwdtimer.db

# ── Frontend Static Files ─────────────────────────────────────────────────────
# Path to the built frontend (set empty to disable backend static serving)
PWD_TIMER_STATIC_DIR=

# ── Security ──────────────────────────────────────────────────────────────────
# Optional token for WebSocket authentication (leave empty to disable)
PWD_TIMER_WS_TOKEN=

# Comma-separated browser origins allowed to call the API in development.
# Defaults in code include localhost/127.0.0.1 on port 5173.
PWD_TIMER_CORS_ORIGINS=

# ── Docker Compose Ports ──────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=80
